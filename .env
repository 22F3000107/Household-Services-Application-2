# Flask App Configuration
FLASK_DEBUG = True
FLASK_APP = app.py
SECRET_KEY=67890123
JWT_SECRET_KEY = 1234567

# Database Configuration
SQLALCHEMY_DATABASE_URI = sqlite:///HSA.sqlite3
SQLALCHEMY_DATABASE_MODIFICATIONS = False

# Celery Configuration (Using Redis as Broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Google Chat Webhook URL
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/your-space-id/messages?key=your-key

# Email Sender Configuration
MAIL_SENDER=no-reply@yourdomain.com